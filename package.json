{
  "name": "clawmail",
  "version": "1.0.0",
  "description": "Secure OpenClaw email plugin for read, organize, and draft-only workflows.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "clawmail": "dist/src/cli.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": ["openclaw", "plugin", "email", "gmail", "outlook", "icloud"],
  "author": "Judah Fuller",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codeberg.org/JudahZF/clawmail.git"
  },
  "bugs": {
    "url": "https://codeberg.org/JudahZF/clawmail/issues"
  },
  "homepage": "https://codeberg.org/JudahZF/clawmail",
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@azure/msal-node": "^5.2.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.3",
    "keytar": "^7.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
