{
  "name": "@JudahZF/clawmailreader",
  "version": "1.1.0",
  "description": "Secure OpenClaw email plugin for read, organize, and draft-only workflows.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "clawmailreader": "dist/src/cli.js"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "openclaw",
    "plugin",
    "email",
    "gmail",
    "outlook",
    "icloud"
  ],
  "author": "Judah Fuller",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@codeberg.org/JudahZF/clawmailreader.git"
  },
  "bugs": {
    "url": "https://codeberg.org/JudahZF/clawmailreader/issues"
  },
  "homepage": "https://codeberg.org/JudahZF/clawmailreader",
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "compat": {
      "pluginApi": "1.0.0"
    },
    "build": {
      "openclawVersion": "1.0.0"
    }
  },
  "files": [
    "dist/src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.15.1",
  "dependencies": {
    "@azure/msal-node": "^5.2.0",
    "googleapis": "^171.4.0",
    "imapflow": "^1.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
